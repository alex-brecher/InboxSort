{
  "manifest_version": 3,
  "name": "InboxSort",
  "version": "1.0.1",
  "description": "Sort your Gmail inbox by date, sender, or unread status. Inline tabs, keyboard shortcuts, stats, and more.",
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
